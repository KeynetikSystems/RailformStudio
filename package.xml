<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>Railform Studio</name>
  <description>Curated curve-to-surface workbench for automotive-grade modeling. Ships native OCCT implementations of every curated action, so it runs fully standalone; the Curves workbench is an optional fallback engine for a few selections. Adds a workflow-ordered UX and Blender Railform rail import.</description>
  <version>0.1.0</version>
  <date>2026-10-24</date>
  <maintainer email="fkemuntoh@gmail.com">Kelvin</maintainer>
  <license file="LICENSE">GPL-3.0-or-later</license>
  <url type="repository" branch="main">https://github.com/KeynetikSystems/RailformStudio</url>
  <url type="readme">https://github.com/KeynetikSystems/RailformStudio/blob/main/README.md</url>
  <url type="bugtracker">https://github.com/KeynetikSystems/RailformStudio/issues</url>
  <!-- The APIs used are all 1.0-era; freecadmin is kept at 1.0 as the
       declared floor. This has only been exercised against FreeCAD 1.1 —
       if an issue surfaces on 1.0, raise the floor instead. -->
  <freecadmin>1.0</freecadmin>
  <content>
    <workbench>
      <classname>RailformStudioWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>rfstudio/resources/rfstudio.svg</icon>
      <description>Curated native OCCT surfacing, with an optional Curves fallback engine.</description>
    </workbench>
  </content>
</package>
